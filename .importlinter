# import-linter contracts — ENFORCED. These are green today; a break is a bug.
#
#   pip install import-linter
#   lint-imports                     # picks this file up automatically
#
# `memsom-layers` below is the strict 9-rank total order (PLAN.md Sec1.1,
# charter amendment A-2). It replaced `.importlinter-goals` (Phase 7,
# "the layers land") -- that file's aspirational, siblings-plus-independence
# layout is now this file's law: the whole refactor target collapses to ONE
# `layers` contract, binary green or red, with no `independence` contracts and
# no same-level pairs. See PLAN.md Sec1.1 for why (a `layers` contract enforces
# nothing WITHIN a level, so a declared sibling pair was a deferred decision
# buying zero enforcement -- the charter's own `acyclic-siblings-mid` contract
# was red via an indirect chain and reported nothing `memsom-layers` didn't).
#
# ---------------------------------------------------------------------------
# FOOTGUN, read before editing: in a `forbidden` contract a bare module name
# means THAT MODULE ONLY, not its descendants. `source_modules = memsom` checks
# memsom/__init__.py and nothing else. To cover a package you must also list
# `memsom.**`. A contract that silently checks one file still reports KEPT, so
# it looks like enforcement and is amnesty. Control-tested 2026-07-31.
# `layers` contracts are the opposite -- they do cover descendants.
#
# SECOND FOOTGUN: `allow_indirect_imports = True` on a `forbidden` contract
# narrows it to DIRECT imports only. On `seam-direction` -- the rule the whole
# 2026-07-30 split rests on -- that would mean memsom could import memsom_panel
# through any one intermediate module and the contract would still report KEPT.
# Nothing here sets it, and nothing here should. If a contract ever seems to
# need it, the contract is wrong or the import is; fix one of those.
# ---------------------------------------------------------------------------

[importlinter]
root_package = memsom
# memsom_panel is not a root package here on purpose: memsom must lint cleanly
# on a machine where the panel is not installed at all.
include_external_packages = True

# ---------------------------------------------------------------------------
# The strict 9-rank total order (PLAN.md Sec1.1). Listed top (most permissive,
# may import everything below) to bottom (most foundational, stdlib only).
# `effects` and `storage` are tied at rank 1 -- both sit directly on top of
# kernel and neither may import the other (no measured edge either way).
# Allowed downward skip: anything -> kernel. Forbidden skip: anything above
# integrity reaching effects directly (an effects boundary with a back door
# is not a boundary) -- a `layers` contract already refuses ANY skip, so this
# is enforced for free, not by a separate rule.
#
# memsom.tuning (Phase 8, PLAN.md Sec2.2, new in this phase) sits directly
# above kernel: low enough that integrity/retrieval/lifecycle/distill/
# federation/bridge/interface can all import it downward to centralize their
# env reads, but not IN kernel -- kernel is stdlib-only and tuning is a real
# registry (dataclasses, a lock, a dict). Two env reads stay outside tuning
# regardless (storage/db.py's MEMDAG_HOME/MEMDAG_DB bootstrap, kernel/paths.py's
# MEMDAG_BRIDGE_MEMORY_DIR) -- see memsom/tuning.py's module docstring and
# scripts/env_ratchet.py's exemption list for why.
# ---------------------------------------------------------------------------
[importlinter:contract:memsom-layers]
name = memsom internal layering
type = layers
layers =
    memsom.interface
    memsom.bridge
    memsom.federation
    memsom.distill
    memsom.lifecycle
    memsom.retrieval
    memsom.integrity
    memsom.effects : memsom.storage
    memsom.tuning
    memsom.kernel

# ---------------------------------------------------------------------------
# The rule the 2026-07-30 split rests on. memsom is the public, stdlib-only
# provenance store; memsom_panel is the machine-side control plane that imports
# it. One-way BY DESIGN -- and until this file, that design was enforced by a
# docstring at memsom/childenv.py:5 and nothing else.
# ---------------------------------------------------------------------------
[importlinter:contract:seam-direction]
name = memsom never imports memsom_panel (the split seam)
type = forbidden
source_modules =
    memsom
    memsom.**
forbidden_modules =
    memsom_panel
    memsom_panel.**

# ---------------------------------------------------------------------------
# ARCHITECTURE.md:108 -- "Frozen core is byte-identical across all builds;
# features are additive-only." The core cannot depend on a feature layer, or it
# is not a core. Prose until now.
#
# NOTE the deliberate absence of `memsom.**` below: the source is the frozen
# core module ITSELF (memsom/__init__.py), not the whole package. Adding the
# wildcard would make every intra-package import a violation. This is the one
# place the bare form is correct.
# ---------------------------------------------------------------------------
[importlinter:contract:frozen-core]
name = the frozen core imports no feature subpackage
type = forbidden
source_modules =
    memsom
forbidden_modules =
    memsom.interface
    memsom.retrieval
    memsom.integrity
    memsom.lifecycle
    memsom.bridge
    memsom.distill
    memsom.federation
